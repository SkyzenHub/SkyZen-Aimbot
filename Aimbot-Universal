local function addToggle(page, name, default, callback)
    local state = default
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -6, 0, 34)
    b.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
    b.Font = Enum.Font.GothamBold
