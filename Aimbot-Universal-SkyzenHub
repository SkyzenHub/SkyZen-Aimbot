-- Ambil identitas tim pemain secara langsung (dibaca ulang tiap frame, jadi selalu terbaru).
-- Mencoba beberapa sistem tim yang umum dipakai game Roblox.
local TEAM_NAMES = {"Team", "team", "TeamName", "Side", "Faction"}

local function ValueToKey(v)
    if v == nil then return nil end
    if typeof(v) == "Instance" then return "I:" .. v.Name end
    return "V:" .. tostring(v)
end

local function GetTeamKey(player)
    -- 1. Sistem Team bawaan Roblox
    if player.Team then
        return "T:" .. player.Team.Name
    end

    -- 2. TeamColor (kalau pemain tidak netral)
    if not player.Neutral then
        return "C:" .. tostring(player.TeamColor)
    end

    -- 3. Attribute pada pemain atau karakter
    for _, name in ipairs(TEAM_NAMES) do
        local v = player:GetAttribute(name)
        if v == nil and player.Character then
            v = player.Character:GetAttribute(name)
        end
        if v ~= nil then
            return "A:" .. tostring(v)
        end
    end

    -- 4. Value (StringValue, ObjectValue, dll) di pemain atau leaderstats
    local holders = {player, player:FindFirstChild("leaderstats")}
    for _, holder in ipairs(holders) do
        if holder then
            for _, name in ipairs(TEAM_NAMES) do
                local obj = holder:FindFirstChild(name)
                if obj and obj:IsA("ValueBase") then
                    local key = ValueToKey(obj.Value)
                    if key then return key end
                end
            end
        end
    end

    return nil
end

-- Apakah pemain satu tim dengan kita (tidak terpengaruh toggle Team Check)
local function SameTeam(player)
    if player == LocalPlayer then
        return true
    end
    local myKey = GetTeamKey(LocalPlayer)
    local theirKey = GetTeamKey(player)
    if not myKey or not theirKey then
        return false
    end
    return myKey == theirKey
end

local function IsEnemy(targetPlayer)
    if targetPlayer == LocalPlayer then
        return false
    end
    if not CONFIG.TEAM_CHECK then
        return true
    end
    return not SameTeam(targetPlayer)
end

local function GetPlayerDistance(player)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return math.huge
    end
    if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
        return math.huge
    end
    return (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
end

local function GetHead(player)
    if not player.Character then return nil end
    return player.Character:FindFirstChild("Head")
end

-- Cek tembok: apakah kepala target terlihat dari kamera (tidak terhalang dinding)
local function IsVisible(head, baseIgnore)
    local origin = Camera.CFrame.Position
    local direction = head.Position - origin

    local ignore = table.clone(baseIgnore)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    for _ = 1, 6 do
        params.FilterDescendantsInstances = ignore
        local result = workspace:Raycast(origin, direction, params)
        if not result then
            return true
        end
        local part = result.Instance
        -- Part transparan atau tanpa tabrakan tidak dianggap tembok
        if part.Transparency >= 0.9 or not part.CanCollide then
            table.insert(ignore, part)
        else
            return false
        end
    end
    return false
end

local function FindClosestEnemy()
    local bestPlayer = nil
    local bestScore = math.huge
    local bestDistance = CONFIG.AIM_DISTANCE
    local center = Camera.ViewportSize / 2

    local baseIgnore
    if CONFIG.WALL_CHECK then
        baseIgnore = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                table.insert(baseIgnore, p.Character)
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if IsEnemy(player) then
            local distance = GetPlayerDistance(player)
            if distance <= CONFIG.AIM_DISTANCE then
                local head = GetHead(player)
                if head then
                    local score = distance
                    local ok = true

                    -- Mode FOV: hanya target di dalam lingkaran crosshair,
                    -- yang paling dekat ke tengah layar dipilih
                    if CONFIG.FOV_ENABLED then
                        local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            score = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                            ok = score <= CONFIG.FOV_RADIUS
                        else
                            ok = false
                        end
                    end

                    if ok and score < bestScore then
                        if not CONFIG.WALL_CHECK or IsVisible(head, baseIgnore) then
                            bestScore = score
                            bestPlayer = player
                            bestDistance = distance
                        end
                    end
                end
            end
        end
    end
    return bestPlayer, bestDistance
end

local function ScreenPos(worldPos)
    local pos, onScreen = Camera:WorldToViewportPoint(worldPos)
    return Vector2.new(pos.X, pos.Y), onScreen
end

local function CreateESPLabel(player)
