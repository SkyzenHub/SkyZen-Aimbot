local SAVE_FILE = "SkyZenHub_Config.json"
local SAVE_KEYS = {
    "AIMBOT_ENABLED", "AUTO_LOCK", "FOV_ENABLED", "WALL_CHECK", "TEAM_CHECK", "SMOOTH_AIM",
    "AIM_DISTANCE", "AIM_SENSITIVITY", "FOV_RADIUS",
    "ESP_ENEMY", "ESP_TEAM", "DRAW_LINES", "ESP_DISTANCE",
    "HOLO_ENEMY", "HOLO_TEAM", "HOLO_OPACITY", "HEALTH_ENEMY", "HEALTH_TEAM",
    "SPEED_ENABLED", "SPEED_VALUE", "INFINITE_JUMP",
}
local ConfigLocked = false

local function LoadConfig()
    if not (isfile and readfile) then return end
    local ok, data = pcall(function()
        if not isfile(SAVE_FILE) then return nil end
        return HttpService:JSONDecode(readfile(SAVE_FILE))
    end)
    if ok and type(data) == "table" then
        for _, key in ipairs(SAVE_KEYS) do
            local v = data[key]
            if v ~= nil and type(v) == type(CONFIG[key]) then
                CONFIG[key] = v
            end
        end
        print("[SkyZenHub] Settings loaded")
    end
end

local function SaveNow()
    if not writefile or ConfigLocked then return end
    local data = {}
    for _, key in ipairs(SAVE_KEYS) do
        data[key] = CONFIG[key]
    end
    pcall(function()
        writefile(SAVE_FILE, HttpService:JSONEncode(data))
    end)
end

local savePending = false
local function SaveConfig()
    if savePending then return end
    savePending = true
    task.delay(0.5, function()
        savePending = false
        SaveNow()
    end)
end

LoadConfig()

