local function Cleanup()
    CONFIG.ENABLED = false
    running = false
    pcall(function() RunService:UnbindFromRenderStep("SkyZenHubAim") end)

    for _, c in ipairs(Conns) do
        pcall(function() c:Disconnect() end)
    end
    Conns = {}

    CONFIG.SPEED_ENABLED = false
    pcall(UpdateSpeed)

    for player in pairs(HoloObjs) do RemoveHolo(player) end
    for player in pairs(HealthBars) do RemoveHealthBar(player) end
    for _, label in pairs(ESPLabels) do label:Destroy() end
    ESPLabels = {}
    for _, f in pairs(LineFrames) do f:Destroy() end
    LineFrames = {}

    for _, n in ipairs({"ESPGui", "LineGui", "FovGui", "HealthGui", "SkyzenGUI"}) do
        local g = GuiParent:FindFirstChild(n)
        if g then g:Destroy() end
    end
end

