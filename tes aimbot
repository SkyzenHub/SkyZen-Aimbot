local ESPLabels = {}
local AimbotActive = false

local TEAM_NAMES = {"Team", "team", "TeamName", "Side", "Faction"}

local function ValueToKey(v)
    if v == nil then return nil end
    if typeof(v) == "Instance" then return "I:" .. v.Name end
    return "V:" .. tostring(v)
end

local function ComputeTeamKey(player)
    -- 1. Sistem Team bawaan Roblox
    if player.Team then
        return "T:" .. player.Team.Name
    end

    -- 2. TeamColor (kalau pemain tidak netral)
    if not player.Neutral then
        return "C:" .. tostring(player.TeamColor)
    end

    -- 3. Attribute pada pemain atau karakter
    for _, name in ipairs(TEAM_NAMES) do
        local v = player:GetAttribute(name)
        if v == nil and player.Character then
            v = player.Character:GetAttribute(name)
        end
        if v ~= nil then
            return "A:" .. tostring(v)
        end
    end

    -- 4. Value (StringValue, ObjectValue, dll) di pemain atau leaderstats
    local holders = {player, player:FindFirstChild("leaderstats")}
    for _, holder in ipairs(holders) do
        if holder then
            for _, name in ipairs(TEAM_NAMES) do
                local obj = holder:FindFirstChild(name)
                if obj and obj:IsA("ValueBase") then
                    local key = ValueToKey(obj.Value)
                    if key then return key end
                end
            end
        end
    end

    return nil
end

local TeamCache = {}

local function RefreshTeam(player)
    TeamCache[player] = ComputeTeamKey(player) or false
end

local function GetTeamKey(player)
    local k = TeamCache[player]
    if k == nil then
        RefreshTeam(player)
        k = TeamCache[player]
    end
    return k or nil
end

local function HookChar(player, char)
    RefreshTeam(player)
    Connect(char.AttributeChanged, function() RefreshTeam(player) end)
end

local function HookPlayer(player)
    RefreshTeam(player)
    Connect(player:GetPropertyChangedSignal("Team"), function() RefreshTeam(player) end)
    Connect(player:GetPropertyChangedSignal("TeamColor"), function() RefreshTeam(player) end)
    Connect(player:GetPropertyChangedSignal("Neutral"), function() RefreshTeam(player) end)
    Connect(player.AttributeChanged, function() RefreshTeam(player) end)
    Connect(player.CharacterAdded, function(char) HookChar(player, char) end)
    if player.Character then HookChar(player, player.Character) end
end

for _, p in ipairs(Players:GetPlayers()) do HookPlayer(p) end
Connect(Players.PlayerAdded, HookPlayer)

-- Cadangan untuk game yang memakai Value/leaderstats sebagai tim
task.spawn(function()
    while running do
        task.wait(0.2)
        for _, p in ipairs(Players:GetPlayers()) do
            RefreshTeam(p)
        end
