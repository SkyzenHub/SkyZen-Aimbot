end)

local function SameTeam(player)
    if player == LocalPlayer then
        return true
    end
    local myKey = GetTeamKey(LocalPlayer)
    local theirKey = GetTeamKey(player)
    if not myKey or not theirKey then
        return false
    end
    return myKey == theirKey
end

-- Teman = satu tim DAN Team Check aktif. Team Check OFF: semua dianggap musuh.
local function IsFriend(player)
    if not CONFIG.TEAM_CHECK then return false end
    return SameTeam(player)
end

local function IsEnemy(player)
    if player == LocalPlayer then return false end
    return not IsFriend(player)
end

