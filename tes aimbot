local HoloObjs = {}

local function RemoveHolo(player)
    local h = HoloObjs[player]
    if h then
        h:Destroy()
        HoloObjs[player] = nil
    end
end

local function CreateHolo(char)
    local h = Instance.new("Highlight")
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.OutlineTransparency = 0
    h.Adornee = char
    local ok = pcall(function() h.Parent = GuiParent end)
    if not ok or not h.Parent then
        h.Parent = char
    end
    return h
end

local function UpdateHolo()
    if not (CONFIG.HOLO_ENEMY or CONFIG.HOLO_TEAM) then
        for player in pairs(HoloObjs) do
            RemoveHolo(player)
        end
        return
    end

    local pulse = math.sin(os.clock() * 3) * 0.08
    local fill = math.clamp((1 - CONFIG.HOLO_OPACITY / 100) + pulse, 0, 1)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local friend = IsFriend(player)
            local wanted = char and IsAlive(player) and ((friend and CONFIG.HOLO_TEAM) or ((not friend) and CONFIG.HOLO_ENEMY))

            if wanted and GetPlayerDistance(player) <= CONFIG.ESP_DISTANCE then
                local h = HoloObjs[player]
                if not h or not h.Parent then
                    h = CreateHolo(char)
                    HoloObjs[player] = h
                end
                if h.Adornee ~= char then
                    h.Adornee = char
                end
                local color = friend and CONFIG.ESP_COLOR_FRIEND or CONFIG.ESP_COLOR_ENEMY
                h.FillColor = color
                h.OutlineColor = color
                h.FillTransparency = fill
            else
                RemoveHolo(player)
            end
        end
    end
end

