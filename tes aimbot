local HealthBars = {}

local function CreateHealthBar()
    local gui = GetGui("HealthGui")

    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 70, 0, 14)
    f.AnchorPoint = Vector2.new(0.5, 0)
    f.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    f.BackgroundTransparency = 0.4
    f.BorderSizePixel = 0
    f.Visible = false
    f.Parent = gui

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(1, 0, 1, 0)
    fill.BackgroundTransparency = 0.2
    fill.BorderSizePixel = 0
    fill.Parent = f

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 10
    txt.TextColor3 = Color3.new(1, 1, 1)
    txt.ZIndex = 2
    txt.Parent = f

    return {frame = f, fill = fill, txt = txt}
end

local function RemoveHealthBar(player)
    local bar = HealthBars[player]
    if bar then
        bar.frame:Destroy()
        HealthBars[player] = nil
    end
end

local function UpdateHealth()
    if not (CONFIG.HEALTH_ENEMY or CONFIG.HEALTH_TEAM) then
        for player in pairs(HealthBars) do
            RemoveHealthBar(player)
        end
        return
    end

    for _, bar in pairs(HealthBars) do
        bar.frame.Visible = false
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local head = GetHead(player)
            local friend = IsFriend(player)
            local wanted = (friend and CONFIG.HEALTH_TEAM) or ((not friend) and CONFIG.HEALTH_ENEMY)

            if wanted and hum and head and hum.Health > 0 and GetPlayerDistance(player) <= CONFIG.ESP_DISTANCE then
                local screenPos, onScreen = ScreenPos(head.Position)
                if onScreen then
                    local bar = HealthBars[player]
                    if not bar or not bar.frame.Parent then
                        bar = CreateHealthBar()
                        HealthBars[player] = bar
                    end

                    local maxHp = math.max(hum.MaxHealth, 1)
                    local ratio = math.clamp(hum.Health / maxHp, 0, 1)
                    bar.fill.Size = UDim2.new(ratio, 0, 1, 0)
                    bar.fill.BackgroundColor3 = Color3.new(1 - ratio, ratio, 0)
                    bar.txt.Text = tostring(math.ceil(hum.Health)) .. "/" .. tostring(math.ceil(maxHp))
                    bar.frame.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y + 4)
                    bar.frame.Visible = true
                end
            elseif HealthBars[player] then
                RemoveHealthBar(player)
            end
        end
    end
end

