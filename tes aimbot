local LineFrames = {}

local function GetLine(player)
    local f = LineFrames[player]
    if not f or not f.Parent then
        f = Instance.new("Frame")
        f.Name = "Line_" .. player.Name
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.BorderSizePixel = 0
        f.Visible = false
        f.Parent = GetGui("LineGui")
        LineFrames[player] = f
    end
    return f
end

local function ClearLine()
    for _, f in pairs(LineFrames) do
        if f and f.Parent then
            f.Visible = false
        end
    end
end

local function UpdateLine()
    ClearLine()
    if not CONFIG.DRAW_LINES then
        return
    end

    local vp = Camera.ViewportSize
    local from = Vector2.new(vp.X / 2, vp.Y)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and IsAlive(player) then
            local head = GetHead(player)
            if head and GetPlayerDistance(player) <= CONFIG.ESP_DISTANCE then
                local screenPos, onScreen = ScreenPos(head.Position)
                if onScreen then
                    local delta = screenPos - from
                    local mid = from + delta / 2

                    local line = GetLine(player)
                    line.BackgroundColor3 = IsFriend(player) and CONFIG.ESP_COLOR_FRIEND or CONFIG.ESP_COLOR_ENEMY
                    line.Position = UDim2.new(0, mid.X, 0, mid.Y)
                    line.Size = UDim2.new(0, delta.Magnitude, 0, 2)
                    line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                    line.Visible = true
                end
            end
        end
    end
end

------------------------------------------------------------
-- AIMBOT
------------------------------------------------------------
local aimDir = nil

local function UpdateAimbot()
    if not CONFIG.AIMBOT_ENABLED or not (AimbotActive or CONFIG.AUTO_LOCK) then
        aimDir = nil
        return
    end

    local target, distance = FindClosestEnemy()
    if not target or distance > CONFIG.AIM_DISTANCE then
        aimDir = nil
        return
    end

    local head = GetHead(target)
    if not head then
        aimDir = nil
        return
    end

    local cameraPos = Camera.CFrame.Position
    local direction = (head.Position - cameraPos).Unit

    if CONFIG.SMOOTH_AIM and CONFIG.AIM_SENSITIVITY < 0.99 then
        if not aimDir then
            aimDir = Camera.CFrame.LookVector
        end
        aimDir = aimDir:Lerp(direction, CONFIG.AIM_SENSITIVITY).Unit
        Camera.CFrame = CFrame.new(cameraPos, cameraPos + aimDir)
    else
        aimDir = nil
        Camera.CFrame = CFrame.new(cameraPos, head.Position)
    end
end

