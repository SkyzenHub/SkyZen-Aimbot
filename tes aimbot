        FovCircle.Parent = g
        Instance.new("UICorner", FovCircle).CornerRadius = UDim.new(1, 0)
        local st = Instance.new("UIStroke", FovCircle)
        st.Color = Color3.fromRGB(230, 30, 55)
        st.Thickness = 1.5

        local function bar(w, h)
            local f = Instance.new("Frame")
