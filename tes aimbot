local function CreateESPLabel(player)
    local gui = GetGui("ESPGui")
    local label = Instance.new("TextLabel")
    label.Name = "ESP_" .. player.Name
    label.Size = UDim2.new(0, 120, 0, 18)
    label.AnchorPoint = Vector2.new(0.5, 1)
    label.BackgroundTransparency = 0.4
    label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = 12
    label.Font = Enum.Font.GothamBold
    label.BorderSizePixel = 0
    label.Visible = false
    label.Parent = gui
    return label
end

local function UpdateESP()
    if not (CONFIG.ESP_ENEMY or CONFIG.ESP_TEAM) then
        for _, label in pairs(ESPLabels) do
            label:Destroy()
        end
        ESPLabels = {}
        return
    end

    for _, label in pairs(ESPLabels) do
        label.Visible = false
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local friend = IsFriend(player)
            local wanted = ((friend and CONFIG.ESP_TEAM) or ((not friend) and CONFIG.ESP_ENEMY))
                and IsAlive(player)
                and GetRoot(player) ~= nil
                and GetPlayerDistance(player) <= CONFIG.ESP_DISTANCE

            local label = ESPLabels[player]
            if wanted then
                local head = GetHead(player)
                if head then
                    local screenPos, onScreen = ScreenPos(head.Position)
                    if onScreen then
                        if not label or not label.Parent then
                            label = CreateESPLabel(player)
                            ESPLabels[player] = label
                        end
                        label.Visible = true
                        label.Position = UDim2.new(screenPos.X / Camera.ViewportSize.X, 0, screenPos.Y / Camera.ViewportSize.Y, 0)
                        label.TextColor3 = friend and CONFIG.ESP_COLOR_FRIEND or CONFIG.ESP_COLOR_ENEMY
                        label.Text = player.Name .. " (" .. tostring(math.floor(GetPlayerDistance(player))) .. ")"
                    end
                end
            elseif label then
                label:Destroy()
                ESPLabels[player] = nil
            end
        end
    end
end

